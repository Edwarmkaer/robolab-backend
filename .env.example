# .env.local (lo escribe `npx convex dev`; no se sube al repo)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Variables del despliegue de Convex: van con `npx convex env set`, NO en archivos del repo.
# `npm run setup` configura las cuatro primeras.
#   JWT_PRIVATE_KEY   clave privada para firmar las sesiones del docente
#   JWKS              clave pública correspondiente
#   SITE_URL          dirección de la web (local: http://localhost:5173)
#   MAIL_PROVIDER     console (desarrollo) o resend (envío real)
#   RESEND_API_KEY    solo con MAIL_PROVIDER=resend
#   MAIL_FROM         solo con MAIL_PROVIDER=resend, ej. "RoboLab <aula@dominio>"
